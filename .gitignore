# Custom symbols, footprints (*.pretty/*.kicad_mod) and 3D models
# (*.step/*.wrl) are intentionally NOT ignored -- they are project source.

# --- KiCad backups & autosave ---
*-backups/
*.kicad_pcb-bak
*.kicad_sch-bak
*.bak
*.sch-bak
*.pro-bak
_autosave-*

# --- Per-user local state (view settings; also holds git.ssh_key field) ---
*.kicad_prl

# --- Lock files (created while a file is open) ---
*.lck
*~

# --- Caches ---
fp-info-cache
sym-lib-table-bak
fp-lib-table-bak

# --- Scratch output dir only. Fab packages you actually order should be
#     committed (e.g. fab/rev_a/) -- no extension globs, so they will be.
gerbers/

# --- OS junk ---
.DS_Store
Thumbs.db
